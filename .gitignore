# --- Environment -----------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/

# --- Data -------------------------------------------------------------------
# The nine raw Olist tables total 121 MB (geolocation alone is 61 MB) and the
# SQLite build is 108 MB, past GitHub's per-file limit. They are course data
# from Canvas; the README says where to put them.
data/raw/
IT5006_Project-Data/

# Derived data is ignored by default, with one deliberate exception: the 4 MB
# artifact the deployed dashboard reads. Rebuilding it needs the raw tables,
# which are not in the repository, so the app could not start without it.
# Note the trailing /* rather than /: git cannot re-include a file whose parent
# directory has itself been excluded, so the negation would silently do nothing.
data/processed/*
!data/processed/orders_dashboard.parquet

# --- Course materials, not ours to redistribute ----------------------------
# The assignment brief, the reference PDFs and the sample reports were provided
# by the course.
/broadway_clean.csv
/phase 1 requirements.docx
/NIBRS_DataDictionary.pdf
/nibrs_diagram.pdf
sample reports (for reference only)/
report/Group10_Milestone1_Report.pdf

# --- Report -----------------------------------------------------------------
# Only the compiled PDF and its figures are tracked. The LaTeX sources are kept
# locally (and on Overleaf) but not in the repository, which is scoped to the
# analysis code, the notebooks and the finished deliverable.
report/*.tex
report/sections/
report/refs.bib
report/stats.txt

# LaTeX build artefacts
report/*.aux
report/*.bbl
report/*.blg
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk

# --- OS --------------------------------------------------------------------
Thumbs.db
.DS_Store
desktop.ini
